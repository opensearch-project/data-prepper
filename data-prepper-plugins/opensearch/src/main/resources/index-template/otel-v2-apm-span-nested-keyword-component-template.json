{
  "version": 1,
  "template": {
    "mappings": {
      "dynamic_templates": [
        {
          "string_events_attributes": {
            "mapping": {
              "type": "keyword",
              "ignore_above": 256
            },
            "path_match": "events.attributes.*",
            "match_mapping_type": "string"
          }
        },
        {
          "string_links_attributes": {
            "mapping": {
              "type": "keyword",
              "ignore_above": 256
            },
            "path_match": "links.attributes.*",
            "match_mapping_type": "string"
          }
        }
      ]
    }
  }
}
